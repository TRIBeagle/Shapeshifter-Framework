<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Full transformation base: hides human parts, apparel, weapons, and genes by default -->
  <ShapeshifterFramework.ShapeshiftFormDef Name="SSF_BaseForm_Animal" Abstract="True">
    <body><mode>Replace</mode></body>
    <head><mode>Hidden</mode></head>
    <hair><mode>Hidden</mode></hair>
    <beard><mode>Hidden</mode></beard>
    <tattooBody><mode>Hidden</mode></tattooBody>
    <tattooHead><mode>Hidden</mode></tattooHead>

    <renderHideApparelLayers><li>All</li></renderHideApparelLayers>
    <renderHideApparelDefNames><li>All</li></renderHideApparelDefNames>
    <renderHideWeaponTags><li>All</li></renderHideWeaponTags>
    <renderHideWeaponDefNames><li>All</li></renderHideWeaponDefNames>
    <renderHideGeneExclusionTags><li>All</li></renderHideGeneExclusionTags>
    <renderHideGeneDefNames><li>All</li></renderHideGeneDefNames>
    <renderHideHediffDefNames><li>All</li></renderHideHediffDefNames>

    <bodyDrawScale>1.0</bodyDrawScale>
    <headDrawScale>1.0</headDrawScale>
    <bodyOffset>(0,0)</bodyOffset>
    <headOffset>(0,0)</headOffset>
	
    <apparelOnTransform>Inventory</apparelOnTransform>
    <weaponsOnTransform>Inventory</weaponsOnTransform>
	
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- Humanoid base: keeps human parts, hides overhead apparel only -->
  <ShapeshifterFramework.ShapeshiftFormDef Name="SSF_BaseForm_Humanoid" Abstract="True">
    <body><mode>Default</mode></body>
    <head><mode>Default</mode></head>
    <hair><mode>Default</mode></hair>
    <beard><mode>Default</mode></beard>
    <tattooBody><mode>Default</mode></tattooBody>
    <tattooHead><mode>Default</mode></tattooHead>

    <renderHideApparelLayers><li>Overhead</li></renderHideApparelLayers>

    <bodyDrawScale>1.0</bodyDrawScale>
    <headDrawScale>1.0</headDrawScale>
    <bodyOffset>(0,0)</bodyOffset>
    <headOffset>(0,0)</headOffset>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- Armored/suit base: keeps human appearance and existing gear, conflicting gear goes to inventory, apparel change locked -->
  <ShapeshifterFramework.ShapeshiftFormDef Name="SSF_BaseForm_Armored" Abstract="True">
    <body><mode>Default</mode></body>
    <head><mode>Default</mode></head>
    <hair><mode>Default</mode></hair>
    <beard><mode>Default</mode></beard>
    <tattooBody><mode>Default</mode></tattooBody>
    <tattooHead><mode>Default</mode></tattooHead>

    <bodyDrawScale>1.0</bodyDrawScale>
    <headDrawScale>1.0</headDrawScale>
    <bodyOffset>(0,0)</bodyOffset>
    <headOffset>(0,0)</headOffset>

    <apparelOnTransform>Keep</apparelOnTransform>
    <weaponsOnTransform>Keep</weaponsOnTransform>

    <conflictingGearHandling>Inventory</conflictingGearHandling>

    <apparelEquipLock>Locked</apparelEquipLock>
    <weaponEquipLock>Unlocked</weaponEquipLock>

  </ShapeshifterFramework.ShapeshiftFormDef>
</Defs>
