<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ======================================================
       변신 규율 연동 감정 — Ideology DLC 전용
       5단계: 절대적으로 혐오함 / 못마땅함 / 관심 없음 / 존중함 / 숭고함
       ====================================================== -->

  <!-- ══════════════ 절대적으로 혐오함 ══════════════ -->

  <!-- 변신 중 기분 -10 (상황 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Abhorrent</defName>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted</workerClass>
    <stages>
      <li>
        <label>변신 중</label>
        <description>이 몸은 내가 아니다. 역겹고 끔찍하다.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신자에 대한 의견 -20 (사회 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Abhorrent_Social</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted_Social</workerClass>
    <stages>
      <li>
        <label>변신자</label>
        <description>몸을 바꾸다니, 보기만 해도 소름이 돋는다.</description>
        <baseOpinionOffset>-20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 금기 위반 기억 감정 -10 (변신 시 1회 부여, 5일 지속) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_ShapeshiftTabooViolated</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>변신해 버렸다</label>
        <description>해선 안 되는 짓을 하고 말았다. 머릿속이 복잡하다.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ══════════════ 못마땅함 ══════════════ -->

  <!-- 변신 중 기분 -5 (상황 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Disapproved</defName>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted</workerClass>
    <stages>
      <li>
        <label>변신 중</label>
        <description>이 모습이 영 불편하다.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신자에 대한 의견 -10 (사회 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Disapproved_Social</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted_Social</workerClass>
    <stages>
      <li>
        <label>변신자</label>
        <description>변신을 하다니, 눈살이 찌푸려진다.</description>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 혐오 위반 기억 감정 -5 (변신 시 1회 부여, 3일 지속) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_ShapeshiftDisapprovedViolated</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>변신을 하고 말았다</label>
        <description>찝찝하다. 좀 그런 거 안 했으면 좋겠는데.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ══════════════ 존중함 ══════════════ -->

  <!-- 변신 중 기분 +5 (상황 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Respected</defName>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted</workerClass>
    <stages>
      <li>
        <label>변신 중</label>
        <description>이 모습도 나쁘지 않군. 꽤 괜찮다.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신자에 대한 의견 +10 (사회 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Respected_Social</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted_Social</workerClass>
    <stages>
      <li>
        <label>변신자</label>
        <description>변신하는 모습이 꽤 인상적이다.</description>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ══════════════ 숭고함 ══════════════ -->

  <!-- 변신 중 기분 +10 (상황 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Sublime</defName>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted</workerClass>
    <stages>
      <li>
        <label>변신 중</label>
        <description>내 안의 힘이 깨어난 느낌이다. 기분이 좋다.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신자에 대한 의견 +20 (사회 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_Shapeshifted_Sublime_Social</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_Precept_Shapeshifted_Social</workerClass>
    <stages>
      <li>
        <label>변신자</label>
        <description>축복받은 변신의 힘을 지니다니, 경이롭다.</description>
        <baseOpinionOffset>20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ══════════════ 변신 목격 기억 감정 ══════════════ -->

  <!-- 변신 목격 — 절대적으로 혐오함: -8 (5일) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_WitnessedShapeshift_Abhorrent</defName>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>변신을 목격함</label>
        <description>누군가 눈앞에서 몸을 바꾸었다. 소름이 끼치고 역겹다.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신 목격 — 못마땅함: -4 (3일) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_WitnessedShapeshift_Disapproved</defName>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>변신을 목격함</label>
        <description>누군가 몸을 바꾸는 걸 봤다. 좀 거슬린다.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신 목격 — 존중함: +4 (3일) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_WitnessedShapeshift_Respected</defName>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>변신을 목격함</label>
        <description>누군가 변신하는 모습을 봤다. 꽤 인상적이었다.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 변신 목격 — 숭고함: +8 (5일) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_WitnessedShapeshift_Sublime</defName>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>변신을 목격함</label>
        <description>신성한 변신을 눈앞에서 목격했다. 경이로운 순간이었다.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ══════════════ 공통 (규율 독립) ══════════════ -->

  <!-- 성스러운 동물 폼 +5 (규율과 독립, 상황 감정) -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSF_Thought_SacredAnimalForm</defName>
    <workerClass>ShapeshifterFramework.Ideology.ThoughtWorker_SacredAnimalForm</workerClass>
    <stages>
      <li>
        <label>성스러운 동물의 형상</label>
        <description>성스러운 동물의 모습을 하고 있다. 경건한 기분이 든다.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
