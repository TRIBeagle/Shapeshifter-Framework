<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================================================
       2a) 아이템 변신 — 자기 자신 (CompTargetable 없음)
       ====================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSFTest_ShiftScroll_Self</defName>
    <label>shift scroll (self)</label>
    <description>사용하면 자기 자신이 늑대로 변신하는 주문서.</description>
    <graphicData>
      <texPath>Things/Item/Special/TechprofSubpersonaCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>120</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <stackLimit>5</stackLimit>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>use shift scroll (self)</useLabel>
      </li>
      <li Class="CompProperties_UseEffectSelfDestruct" />
      <li Class="ShapeshifterFramework.Comps.CompProperties_UseEffect_ShiftTarget">
        <formDefName>SSFTest_WolfForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </ThingDef>

  <!-- ======================================================
       2b) 아이템 변신 — 대상 지정 (CompTargetable_SinglePawn)
       ====================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSFTest_ShiftScroll_Target</defName>
    <label>shift scroll (target)</label>
    <description>클릭한 대상을 늑대로 변신시키는 주문서. 대상을 선택하면 걸어가서 사용.</description>
    <graphicData>
      <texPath>Things/Item/Special/TechprofSubpersonaCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>150</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <stackLimit>5</stackLimit>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>use shift scroll on...</useLabel>
      </li>
      <li Class="CompProperties_UseEffectSelfDestruct" />
      <li Class="ShapeshifterFramework.Comps.CompProperties_UseEffect_ShiftTarget">
        <formDefName>SSFTest_WolfForm</formDefName>
        <successChance>1.0</successChance>
      </li>
      <li Class="CompProperties_Targetable">
        <compClass>CompTargetable_SinglePawn</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
