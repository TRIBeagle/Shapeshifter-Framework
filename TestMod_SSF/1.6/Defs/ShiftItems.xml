<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================================================
       Hediff 정의
       ====================================================== -->

  <!-- 야수 팔 (AddedPart) — 늑대 폼에서 팔 교체 테스트 -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>SSFTest_BeastArm</defName>
    <hediffClass>Hediff_AddedPart</hediffClass>
    <label>beast arm</label>
    <description>A mutated beast arm grafted through shapeshifting.</description>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>0.85</partEfficiency>
    </addedPartProps>
  </HediffDef>

  <!-- 야수 손 (HediffWithComps) — 추가 파트 테스트용 -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>SSFTest_BeastHand</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>beast hand</label>
    <description>A mutated beast hand grafted through shapeshifting.</description>
  </HediffDef>

  <!-- ======================================================
       투사체 정의
       ====================================================== -->

  <!-- 안전판 파편수류탄 — 수인 폼 verb 테스트용 -->
  <ThingDef ParentName="BaseBullet">
    <defName>SSFTest_Proj_FragGrenade_Safe</defName>
    <label>frag grenade (SSF safe)</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>60</damageAmountBase>
      <explosionRadius>3.9</explosionRadius>
      <ai_IsIncendiary>false</ai_IsIncendiary>
      <flyOverhead>false</flyOverhead>
      <speed>25</speed>
      <soundExplode>Explosion_Grenade</soundExplode>
    </projectile>
  </ThingDef>

  <!-- ======================================================
       필스(혈흔) 정의
       ====================================================== -->

  <!-- 곤충형 혈흔 — bloodSmearDef 테스트용 -->
  <ThingDef ParentName="FilthBlood">
    <defName>SSFTest_Filth_BloodInsectSmear</defName>
    <label>blood smear</label>
    <graphicData>
      <texPath>Things/Filth/CrawlSmear</texPath>
      <color>(132, 138, 114, 165)</color>
      <graphicClass>Graphic_ClusterTight</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
  </ThingDef>

  <!-- ======================================================
       아이템 정의
       ====================================================== -->

  <!-- 마력의 돌 — requiredItems 조건 테스트용 -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSFTest_MagicStone</defName>
    <label>Test: 마력의 돌</label>
    <description>인벤토리에 소지하기만 해도 변신 기즈모를 활성화해 주는 신비한 돌입니다. 바닥에 버리면 변신이 풀립니다.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Jade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <!-- ======================================================
       2a) 아이템 변신 — 자기 자신 (CompTargetable 없음)
       ====================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSFTest_ShiftScroll_Self</defName>
    <label>shift scroll (self)</label>
    <description>사용하면 자기 자신이 늑대로 변신하는 주문서.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>120</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <stackLimit>5</stackLimit>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>use shift scroll (self)</useLabel>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
      <li Class="ShapeshifterFramework.Comps.CompProperties_UseEffect_ShiftTarget">
        <formDefName>SSFTest_BearForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </ThingDef>

  <!-- ======================================================
       2b) 아이템 변신 — 대상 지정 (CompTargetable_SinglePawn)
       ====================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSFTest_ShiftScroll_Target</defName>
    <label>shift scroll (target)</label>
    <description>클릭한 대상을 늑대로 변신시키는 주문서. 대상을 선택하면 걸어가서 사용.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>150</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <stackLimit>5</stackLimit>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>use shift scroll on...</useLabel>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
      <li Class="ShapeshifterFramework.Comps.CompProperties_UseEffect_ShiftTarget">
        <formDefName>SSFTest_BearForm</formDefName>
        <successChance>1.0</successChance>
      </li>
      <li Class="CompProperties_Targetable">
        <compClass>CompTargetable_SinglePawn</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
