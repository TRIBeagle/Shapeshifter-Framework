<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================================================
       변신 폼 정의
       ====================================================== -->

  <!-- 1) 베어 폼 (동물형) — 약물/아이템 전용, 어빌리티 바에 표시 안 함
       ★ 체형 교체 텍스처, hediff, 이펙트 통합 테스트
       ★ 스탯/능력치 → mainHediff(SSFTest_BearFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Animal">
    <defName>SSFTest_BearForm</defName>
    <label>bear form</label>
    <description>테스트용 곰 변신. 동물형 완전 변신. 곰 텍스처로 체형 교체, 캐릭터 능력 보정, hediff 부여 테스트.</description>
    <mainHediff>SSFTest_BearFormHediff</mainHediff>
    <!-- 체형 교체 텍스처 -->
    <body>
      <mode>Replace</mode>
      <replacementTexPath>Things/Pawn/Animal/Bear/Bear</replacementTexPath>
      <swimmingReplacementTexPath>Things/Pawn/Animal/Bear/SwimmingBear</swimmingReplacementTexPath>
      <color>(112,82,65)</color>
      <swimmingColor>(255,255,255)</swimmingColor>
    </body>
    <bodyDrawScale>2.5</bodyDrawScale>
    <durationTicks>15000</durationTicks>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <!-- hediff 부여 -->
    <addHediffs>
      <li>
        <hediff>FibrousMechanites</hediff>
        <severity>0.5</severity>
      </li>
      <li>
        <hediff>SSFTest_BeastArm</hediff>
        <targetPart>Arm</targetPart>
        <addedPartPolicy>ForceAdd</addedPartPolicy>
      </li>
    </addHediffs>
    <addAbilities>
      <li MayRequire="Ludeon.Royalty">Berserk</li>
    </addAbilities>
    <apparelOnTransform>Drop</apparelOnTransform>
    <weaponsOnTransform>Drop</weaponsOnTransform>
    <tools>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>12</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
    </tools>
    <replaceNativeTools>true</replaceNativeTools>
    <!-- 혈액/살점 -->
    <bloodDef>Filth_BloodInsect</bloodDef>
    <bloodSmearDef>SSFTest_Filth_BloodInsectSmear</bloodSmearDef>
    <fleshType>Insectoid</fleshType>
    <!-- 변신 이펙트 -->
    <transformFxCooldownTicks>30</transformFxCooldownTicks>
    <transformEnterFleck>PsycastSkipFlashEntry</transformEnterFleck>
    <transformEnterFleckCount>1</transformEnterFleckCount>
    <transformEnterFleckScale>1.8</transformEnterFleckScale>
    <transformEnterSound>PsychicPulseGlobal</transformEnterSound>
    <transformExitFleck>PsycastSkipFlashExit</transformExitFleck>
    <transformExitFleckCount>1</transformExitFleckCount>
    <transformExitFleckScale>1.8</transformExitFleckScale>
    <transformExitSound>PsychicSootheGlobal</transformExitSound>
    <gizmoIconPathEnter>UI/Commands/SSF_Shift_Enter</gizmoIconPathEnter>
    <gizmoIconPathRevert>UI/Commands/SSF_Shift_Revert</gizmoIconPathRevert>
  </ShapeshifterFramework.ShapeshiftFormDef>


  <!-- 2) 곰 전사 폼 (아머드형) — 버프 어빌리티용 동료 강화
       ★ 사운드 오버라이드 통합 테스트
       ★ 스탯 → mainHediff(SSFTest_BearWarriorFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Armored">
    <defName>SSFTest_BearWarriorForm</defName>
    <label>bear warrior form</label>
    <description>테스트용 곰 전사 변신. 장비 유지하면서 스탯 강화. 곰 사운드 오버라이드.</description>
    <mainHediff>SSFTest_BearWarriorFormHediff</mainHediff>
    <bodyDrawScale>1.3</bodyDrawScale>
    <durationTicks>15000</durationTicks>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <!-- 사운드 오버라이드 -->
    <soundAngry>Pawn_Bear_Angry</soundAngry>
    <soundMeleeHitPawn>Shot_Charge_Blaster</soundMeleeHitPawn>
    <soundMeleeHitBuilding>Explosion_EMP</soundMeleeHitBuilding>
    <soundMeleeMiss>Pawn_Mech_Scyther_Call</soundMeleeMiss>
    <!-- 이펙트 -->
    <transformEnterEffecter>Vaporize_Heatwave</transformEnterEffecter>
    <transformExitEffecter>ImpactSmallDustCloud</transformExitEffecter>
    <gizmoIconPathEnter>UI/Commands/SSF_Shift_Entertest</gizmoIconPathEnter>
    <gizmoIconPathRevert>UI/Commands/SSF_Shift_Reverttest</gizmoIconPathRevert>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- 3) 양 폼 (동물형) — 디버프/범위형용. 해제 불가
       ★ 스탯 → mainHediff(SSFTest_SheepFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Animal">
    <defName>SSFTest_SheepForm</defName>
    <label>sheep form</label>
    <description>테스트용 양 변신. 전투력 상실, 자발적 해제 불가.</description>
    <mainHediff>SSFTest_SheepFormHediff</mainHediff>
    <!-- 양 텍스처로 체형 교체 -->
    <body>
      <mode>Replace</mode>
      <replacementTexPath>Things/Pawn/Animal/Sheep/SheepMale</replacementTexPath>
      <female>
        <replacementTexPath>Things/Pawn/Animal/Sheep/SheepFemale</replacementTexPath>
      </female>
    </body>
    <bodyDrawScale>0.6</bodyDrawScale>
    <durationTicks>10000</durationTicks>
    <canRevertVoluntarily>false</canRevertVoluntarily>
    <disabledWorkTagsOnTransform>
      <li>Violent</li>
    </disabledWorkTagsOnTransform>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- ======================================================
       장비 소환 변신 폼
       ====================================================== -->

  <!-- 4) 암흑 기사 폼 (장비 소환형) — 전용 갑옷+무기 소환, 해제 시 자동 파괴
       ★ 스탯 → mainHediff(SSFTest_DarkKnightFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Armored">
    <defName>SSFTest_DarkKnightForm</defName>
    <label>dark knight form</label>
    <description>암흑 기사로 변신. 전용 갑옷과 무기가 소환되며, 기존 장비는 인벤토리로 이동. 해제 시 소환 장비는 소멸.</description>
    <mainHediff>SSFTest_DarkKnightFormHediff</mainHediff>
    <bodyDrawScale>1.2</bodyDrawScale>
    <durationTicks>18000</durationTicks>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <apparelOnTransform>Inventory</apparelOnTransform>
    <weaponsOnTransform>Inventory</weaponsOnTransform>
    <apparelEquipLock>Locked</apparelEquipLock>
    <weaponEquipLock>Locked</weaponEquipLock>
    <spawnApparelOnTransform>
      <li>Apparel_PlateArmor</li>
    </spawnApparelOnTransform>
    <spawnWeaponOnTransform>
      <li>MeleeWeapon_LongSword</li>
    </spawnWeaponOnTransform>
    <spawnApparelStuff>Plasteel</spawnApparelStuff>
    <spawnWeaponStuff>Plasteel</spawnWeaponStuff>
    <conflictingGearHandling>Inventory</conflictingGearHandling>
    <gizmoIconPathEnter>UI/Commands/SSF_Shift_Entertest</gizmoIconPathEnter>
    <gizmoIconPathRevert>UI/Commands/SSF_Shift_Reverttest</gizmoIconPathRevert>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- ======================================================
       다단 변신 폼: 인간 → 수인 → 야수
       ====================================================== -->

  <!-- 5a) 수인 폼 (휴머노이드형) — 1단계: 인간→수인
       ★ 귀/꼬리 renderNodeProperties, 보이스, verb, verbGizmoOptions 통합 테스트
       ★ addAbilities에 FullBeast 어빌리티 추가 (2단 변신용)
       ★ 스탯 → mainHediff(SSFTest_BeastkinFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Humanoid">
    <defName>SSFTest_BeastkinForm</defName>
    <label>beastkin form</label>
    <description>수인 형태. 귀/꼬리 그래픽 추가, 다양한 원거리 verb 통합 테스트. 수인 상태에서 2단 변신(완전 야수) 가능.</description>
    <mainHediff>SSFTest_BeastkinFormHediff</mainHediff>
    <bodyDrawScale>1.20</bodyDrawScale>
    <headDrawScale>1.05</headDrawScale>
    <headOffset>(0.0, 0.03)</headOffset>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <apparelOnTransform>Inventory</apparelOnTransform>
    <weaponsOnTransform>Keep</weaponsOnTransform>
    <!-- hediff -->
    <addHediffs>
      <li>
        <hediff>FibrousMechanites</hediff>
      </li>
    </addHediffs>
    <!-- addAbilities: 2단 변신(FullBeast) + 기타 -->
    <addAbilities>
      <li MayRequire="Ludeon.Royalty">Waterskip</li>
      <li>SSFTest_Ability_FullBeast</li>
    </addAbilities>
    <!-- 그래픽 표시 예외 -->
    <renderShowApparelDefNames>
      <li>Apparel_Cape</li>
      <li>Apparel_Tuque</li>
    </renderShowApparelDefNames>
    <!-- ★ 귀/꼬리 그래픽 -->
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Pawn/Humanlike/HeadAttachments/FloppyEars/FloppyEars</texPath>
        <colorType>Skin</colorType>
        <parentTagDef>Head</parentTagDef>
        <useSkinShader>true</useSkinShader>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <defaultData>
            <layer>70</layer>
          </defaultData>
        </drawData>
      </li>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/FurryTail/FurryTail</texPath>
        <colorType>Hair</colorType>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0.1, 0, -0.25)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(-0.1, 0, -0.25)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, -0.15)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, -0.15)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <!-- ★ 기본 컬러 오버라이드 -->
    <hairColor>(0.85, 0.85, 0.95)</hairColor>
    <!-- ★ 보이스 오버라이드 -->
    <soundCall>Pawn_Furskin_Call</soundCall>
    <soundDeath>Pawn_Furskin_Death</soundDeath>
    <soundWounded>Pawn_Furskin_Wounded</soundWounded>
    <soundAngry>Pawn_Bear_Angry</soundAngry>
    <soundEating>PredatorLarge_Eat</soundEating>
    <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
    <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
    <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    <!-- 혈액/살점 -->
    <bloodDef>Filth_BloodInsect</bloodDef>
    <bloodSmearDef>SSFTest_Filth_BloodInsectSmear</bloodSmearDef>
    <fleshType>Insectoid</fleshType>
    <!-- ★ 다양한 verb 타입 테스트 -->
    <verbs>
      <li Class="Verse.VerbProperties">
        <label>AssaultRifle</label>
        <verbClass>Verse.Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_AssaultRifle</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>28</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <requireLineOfSight>true</requireLineOfSight>
        <stopBurstWithoutLos>true</stopBurstWithoutLos>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>false</canTargetLocations>
        </targetParams>
      </li>
      <li Class="Verse.VerbProperties">
        <verbClass>Verse.Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SSFTest_Proj_FragGrenade_Safe</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>13</range>
        <forcedMissRadius>0</forcedMissRadius>
        <requireLineOfSight>true</requireLineOfSight>
        <stopBurstWithoutLos>true</stopBurstWithoutLos>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
      </li>
      <li Class="Verse.VerbProperties">
        <label>ArcSprayProjectile</label>
        <verbClass>Verse.Verb_ArcSprayProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_IncendiaryLauncher</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>16</range>
        <requireLineOfSight>true</requireLineOfSight>
        <stopBurstWithoutLos>true</stopBurstWithoutLos>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
      <li Class="Verse.VerbProperties">
        <label>SpewFire</label>
        <verbClass>Verse.Verb_SpewFire</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>true</onlyManualCast>
        <warmupTime>1.2</warmupTime>
        <range>10</range>
        <minRange>1</minRange>
        <requireLineOfSight>true</requireLineOfSight>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
      <li>
        <label>ShootBeam</label>
        <verbClass>Verb_ShootBeam</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <warmupTime>1.0</warmupTime>
        <range>24.9</range>
        <minRange>3.9</minRange>
        <beamFullWidthRange>6.9</beamFullWidthRange>
        <burstShotCount>5</burstShotCount>
        <showBurstShotStats>false</showBurstShotStats>
        <beamWidth>6</beamWidth>
        <ticksBetweenBurstShots>22</ticksBetweenBurstShots>
        <beamDamageDef>Beam</beamDamageDef>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <soundCastBeam>BeamGraser_Shooting</soundCastBeam>
        <beamGroundFleckDef>Fleck_BeamBurn</beamGroundFleckDef>
        <beamFleckChancePerTick>0.32</beamFleckChancePerTick>
        <beamMaxDeviation>1.5</beamMaxDeviation>
        <beamCurvature>0.6</beamCurvature>
        <beamMoteDef>Mote_GraserBeamBase</beamMoteDef>
        <beamEndEffecterDef>GraserBeam_End</beamEndEffecterDef>
        <beamChanceToStartFire>0.85</beamChanceToStartFire>
        <beamChanceToAttachFire>0.85</beamChanceToAttachFire>
        <beamFireSizeRange>0.55~0.85</beamFireSizeRange>
        <beamLineFleckDef>Fleck_BeamSpark</beamLineFleckDef>
        <beamStartOffset>0.8</beamStartOffset>
        <beamLineFleckChanceCurve>
          <points>
            <li>(0, 0)</li>
            <li>(0.65, 0.4)</li>
            <li>(1, 0.75)</li>
          </points>
        </beamLineFleckChanceCurve>
      </li>
    </verbs>
    <!-- ★ verbGizmoOptions -->
    <verbGizmoOptions>
      <li>
        <label>돌격소총</label>
        <iconPath>Things/Item/Equipment/WeaponRanged/AssaultRifle</iconPath>
        <autoAttackDefault>true</autoAttackDefault>
      </li>
      <li>
        <label>파편수류탄</label>
        <iconPath>Things/Item/Equipment/WeaponRanged/Grenades</iconPath>
        <autoAttackDefault>false</autoAttackDefault>
      </li>
      <li>
        <label>화염방사</label>
        <iconPath>Things/Item/Equipment/WeaponRanged/InfernoCannon</iconPath>
        <autoAttackDefault>false</autoAttackDefault>
      </li>
      <li>
        <label>화염 분사</label>
        <iconPath>Things/Item/Equipment/WeaponRanged/IncendiaryLauncher</iconPath>
        <autoAttackDefault>false</autoAttackDefault>
      </li>
      <li>
        <label>광선 빔</label>
        <iconPath>Things/Item/Equipment/WeaponRanged/ThumpCannon</iconPath>
        <autoAttackDefault>false</autoAttackDefault>
      </li>
    </verbGizmoOptions>
    <tools>
      <li>
        <label>claws</label>
        <capacities><li>Scratch</li></capacities>
        <power>10</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
      </li>
    </tools>
    <replaceNativeVerbs>false</replaceNativeVerbs>
    <replaceNativeTools>false</replaceNativeTools>
    <disabledWorkTagsOnTransform>
      <li>Crafting</li>
      <li>Cooking</li>
    </disabledWorkTagsOnTransform>
    <!-- 변신 이펙트 -->
    <transformFxCooldownTicks>30</transformFxCooldownTicks>
    <transformEnterFleck>PsycastSkipFlashEntry</transformEnterFleck>
    <transformEnterFleckCount>1</transformEnterFleckCount>
    <transformEnterFleckScale>1.8</transformEnterFleckScale>
    <transformEnterSound>PsychicPulseGlobal</transformEnterSound>
    <transformExitFleck>PsycastSkipFlashExit</transformExitFleck>
    <transformExitFleckCount>1</transformExitFleckCount>
    <transformExitFleckScale>1.8</transformExitFleckScale>
    <transformExitSound>PsychicSootheGlobal</transformExitSound>
    <gizmoIconPathEnter>UI/Commands/SSF_Shift_Enter</gizmoIconPathEnter>
    <gizmoIconPathRevert>UI/Commands/SSF_Shift_Revert</gizmoIconPathRevert>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- 5b) 야수 폼 (동물형) — 2단계: 수인→야수 (수인의 addAbilities로 부여)
       ★ 스탯 → mainHediff(SSFTest_FullBeastFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Animal">
    <defName>SSFTest_FullBeastForm</defName>
    <label>full beast form</label>
    <description>완전한 야수 형태. 수인 상태에서만 변신 가능 (수인 폼의 addAbilities로 어빌리티 부여).</description>
    <mainHediff>SSFTest_FullBeastFormHediff</mainHediff>
    <bodyDrawScale>1.0</bodyDrawScale>
    <durationTicks>12000</durationTicks>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <tools>
      <li>
        <label>fangs</label>
        <capacities><li>Bite</li></capacities>
        <power>18</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claws</label>
        <capacities><li>Scratch</li></capacities>
        <power>14</power>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
      </li>
    </tools>
    <replaceNativeTools>true</replaceNativeTools>
  </ShapeshifterFramework.ShapeshiftFormDef>

  <!-- ======================================================
       조건부 / 비주얼 / 종족제한 테스트 폼
       ====================================================== -->

  <!-- 6) 수호자 폼 — sustainHediffs로 유지 조건
       ★ portraitDrawScale, bodyOffset, shadowVolume/Offset 통합 테스트
       ★ 스탯 → mainHediff(SSFTest_GuardianFormHediff)의 stages에서 정의 -->
  <ShapeshifterFramework.ShapeshiftFormDef ParentName="SSF_BaseForm_Humanoid">
    <defName>SSFTest_GuardianForm</defName>
    <label>guardian form</label>
    <description>수호자 형태. 마력의 돌 소지 또는 수호자의 각인 보유 시 변신 유지. 큰 그림자와 포트레잇 확대 테스트.</description>
    <mainHediff>SSFTest_GuardianFormHediff</mainHediff>
    <bodyDrawScale>1.4</bodyDrawScale>
    <portraitDrawScale>1.3</portraitDrawScale>
    <bodyOffset>(0, -0.1)</bodyOffset>
    <durationTicks>12000</durationTicks>
    <canRevertVoluntarily>true</canRevertVoluntarily>
    <!-- sustain: 수호자의 각인이 유지되어야 함 (Any 모드 — 돌 소지 or 각인 중 하나) -->
    <sustainHediffs>
      <li>SSFTest_Hediff_GuardianMark</li>
    </sustainHediffs>
    <sustainMode>Any</sustainMode>
    <!-- 그림자 오버라이드 -->
    <body>
      <mode>Default</mode>
      <shadowVolume>(0.6, 1.0, 0.6)</shadowVolume>
      <shadowOffset>(0, 0, -0.05)</shadowOffset>
    </body>
    <gizmoIconPathEnter>UI/Commands/SSF_Shift_Enter</gizmoIconPathEnter>
    <gizmoIconPathRevert>UI/Commands/SSF_Shift_Revert</gizmoIconPathRevert>
  </ShapeshifterFramework.ShapeshiftFormDef>

