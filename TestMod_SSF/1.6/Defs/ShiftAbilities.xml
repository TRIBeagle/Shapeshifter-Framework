<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================================================
       어빌리티: 동료 변신 (버프형)
       곰 전사 폼으로 변신시켜 전투력 강화
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseTargetedShiftAbility">
    <defName>SSFTest_Ability_BuffAlly</defName>
    <label>bestow bear warrior</label>
    <description>동료에게 곰 전사의 힘을 부여한다. 장비를 유지한 채 스탯이 강화된다.</description>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <displayOrder>500</displayOrder>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <!-- hediffDef 경로 테스트: formDefName 대신 hediffDef 직접 지정 -->
        <hediffDef>SSFTest_BearWarriorFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 적 변신 (디버프형)
       적을 양으로 변신시켜 무력화
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseTargetedShiftAbility">
    <defName>SSFTest_Ability_DebuffEnemy</defName>
    <label>polymorph: sheep</label>
    <description>적을 양으로 변신시킨다. 전투력을 상실하며 자발적 해제 불가.</description>
    <cooldownTicksRange>3000</cooldownTicksRange>
    <hostile>true</hostile>
    <displayOrder>501</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <violent>false</violent>
      <range>20</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_SheepFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 암흑 기사 변신
       플라스틸 판금갑옷 + 장검 소환, 해제 시 소멸
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_DarkKnight</defName>
    <label>dark knight transformation</label>
    <description>암흑 기사로 변신한다. 전용 플라스틸 판금갑옷과 장검이 소환되며, 기존 장비는 인벤토리로 이동. 해제 시 소환 장비는 소멸한다.</description>
    <cooldownTicksRange>3000</cooldownTicksRange>
    <displayOrder>505</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <violent>false</violent>
      <range>0</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_DarkKnightFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 수인 변신 (1단계)
       인간 → 수인. 수인 상태에서 addAbilities로 FullBeast 진입 가능.
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_Beastkin</defName>
    <label>beastkin shift</label>
    <description>수인 형태로 변신한다. 수인 상태에서는 2단 변신(완전 야수)이 가능.</description>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <displayOrder>510</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_BeastkinFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 완전 야수 변신 (2단계)
       수인 상태의 addAbilities로 부여됨
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_FullBeast</defName>
    <label>full beast shift</label>
    <description>완전한 야수 형태로 변신한다. 수인 상태에서만 사용 가능.</description>
    <cooldownTicksRange>0</cooldownTicksRange>
    <displayOrder>511</displayOrder>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_FullBeastFormHediff</hediffDef>
        <!-- 수인 폼에서만 2단 변신 허용 -->
        <allowedFromForms>
          <li>SSFTest_BeastkinForm</li>
        </allowedFromForms>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 수호자 폼
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_Guardian</defName>
    <label>guardian shift</label>
    <description>수호자 형태로 변신한다.</description>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <displayOrder>530</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.8</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_GuardianFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 유령 폼
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_Phantom</defName>
    <label>phantom shift</label>
    <description>유령 형태로 변신한다. 반투명 머리, 마른 체형.</description>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <displayOrder>531</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_PhantomFormHediff</hediffDef>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       어빌리티: 종족 제한 (인간 전용)
       allowedRaces를 comp에서 처리
       ====================================================== -->
  <AbilityDef ParentName="SSF_BaseSelfShiftAbility">
    <defName>SSFTest_Ability_RaceLocked</defName>
    <label>race-locked shift</label>
    <description>인간 전용 강화 변신. 비인간 종족은 사용 불가.</description>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <displayOrder>532</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.8</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityGiveHediff_Shapeshift">
        <hediffDef>SSFTest_RaceLockedFormHediff</hediffDef>
        <!-- 종족 제한: 인간만 -->
        <allowedRaces>
          <li>Human</li>
        </allowedRaces>
      </li>
    </comps>
  </AbilityDef>


</Defs>
