<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================================================
       3) 어빌리티: 동료 변신 (버프형)
       곰 전사 폼으로 변신시켜 전투력 강화
       ====================================================== -->
  <AbilityDef>
    <defName>SSFTest_Ability_BuffAlly</defName>
    <label>bestow bear warrior</label>
    <description>동료에게 곰 전사의 힘을 부여한다. 장비를 유지한 채 스탯이 강화된다.</description>
    <iconPath>UI/Commands/SSF_Shift_Enter</iconPath>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <hostile>false</hostile>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <displayOrder>500</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <violent>false</violent>
      <range>15</range>
      <warmupTime>1.0</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityShiftTarget">
        <formDefName>SSFTest_BearWarriorForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       4) 어빌리티: 적 변신 (디버프형)
       적을 양으로 변신시켜 무력화
       ====================================================== -->
  <AbilityDef>
    <defName>SSFTest_Ability_DebuffEnemy</defName>
    <label>polymorph: sheep</label>
    <description>적을 양으로 변신시킨다. 전투력을 상실하며 자발적 해제 불가.</description>
    <iconPath>UI/Commands/SSF_Shift_Enter</iconPath>
    <cooldownTicksRange>3000</cooldownTicksRange>
    <hostile>true</hostile>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <displayOrder>501</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityShiftTarget">
        <formDefName>SSFTest_SheepForm</formDefName>
        <successChance>0.75</successChance>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       5) 장비소환 어빌리티: 암흑 기사 변신
       플라스틸 판금갑옷 + 장검 소환, 해제 시 소멸
       ====================================================== -->
  <AbilityDef>
    <defName>SSFTest_Ability_DarkKnight</defName>
    <label>dark knight transformation</label>
    <description>암흑 기사로 변신한다. 전용 플라스틸 판금갑옷과 장검이 소환되며, 기존 장비는 인벤토리로 이동. 해제 시 소환 장비는 소멸한다.</description>
    <iconPath>UI/Commands/SSF_Shift_Enter</iconPath>
    <cooldownTicksRange>3000</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <displayOrder>505</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <violent>false</violent>
      <range>0</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityShiftTarget">
        <formDefName>SSFTest_DarkKnightForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       6) 3단 변신 어빌리티: 수인 변신
       인간 → 수인 (수인 상태에서 다시 사용하면 야수 폼으로는
       별도 기즈모로 진입 — allowedFromForms 조건 충족)
       ====================================================== -->
  <AbilityDef>
    <defName>SSFTest_Ability_Beastkin</defName>
    <label>beastkin shift</label>
    <description>수인 형태로 변신한다. 수인 상태에서는 기즈모로 완전한 야수 형태로 2단 변신 가능.</description>
    <iconPath>UI/Commands/SSF_Shift_Enter</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <displayOrder>510</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityShiftTarget">
        <formDefName>SSFTest_BeastkinForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </AbilityDef>

  <!-- ======================================================
       7) 조건부 변신 어빌리티: 수호자 폼
       마력의 돌 OR FibrousMechanites 필요
       ====================================================== -->
  <AbilityDef>
    <defName>SSFTest_Ability_Guardian</defName>
    <label>guardian shift</label>
    <description>수호자 형태로 변신한다. 마력의 돌 소지 또는 FibrousMechanites 보유 시에만 사용 가능.</description>
    <iconPath>UI/Commands/SSF_Shift_Enter</iconPath>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <displayOrder>530</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <violent>false</violent>
      <warmupTime>0.8</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ShapeshifterFramework.Comps.CompProperties_AbilityShiftTarget">
        <formDefName>SSFTest_GuardianForm</formDefName>
        <successChance>1.0</successChance>
      </li>
    </comps>
  </AbilityDef>

